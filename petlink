        self.NAV_COLOR = "#315B5B"
        self.BUTTON_COLOR = "#568585"
        self.WHITE = "#FFFFFF"
        self.TEXT_COLOR = "#222222"
        self.SUBTEXT_COLOR = "#777777"
        self.GREEN = "#4F8A5B"
        self.RED = "#B85C5C"
        self.YELLOW = "#B58B35"

        # STORAGE (NO DATABASE)
        self.accounts = {}
        self.pets = []
        self.stray_reports = []
        self.applications = []
        self.current_user = None

        self.show_login()

