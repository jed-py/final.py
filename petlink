    def add_profile_record(self, parent, heading, records, formatter):
        tk.Label(
            parent,
            text=heading,
            font=("Arial", 11, "bold"),
            bg=self.WHITE,
            fg=self.NAV_COLOR
        ).pack(pady=(4, 1))

        if not records:
            tk.Label(
                parent,
                text="No records.",
                font=("Arial", 9),
                bg=self.WHITE,
                fg=self.SUBTEXT_COLOR
            ).pack()
            return

        for record in records:
            tk.Label(
                parent,
                text=formatter(record),
                font=("Arial", 9),
                bg=self.WHITE,
                fg=self.TEXT_COLOR
            ).pack()

