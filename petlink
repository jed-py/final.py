    def register(self, first_name, second_name, password, confirm_password):
        first = first_name.get().strip()
        second = second_name.get().strip()
        pw = password.get()
        confirm = confirm_password.get()

        if not first or not second:
            messagebox.showinfo(
                "PetLink",
                "Please enter your first and second name."
            )
            return

        if not pw:
            messagebox.showinfo("PetLink", "Please enter a password.")
            return

        if pw != confirm:
            messagebox.showerror("PetLink", "Passwords do not match.")
            return

        username = "".join(
            char for char in (first + second).lower()
            if char.isalpha()
        )

        original = username
        counter = 1

        while username in self.accounts:
            username = original + "a" * counter
            counter += 1

        self.accounts[username] = {
            "password": pw,
            "first_name": first,
            "second_name": second,
            "adopted": [],
            "rescued": []
        }

        messagebox.showinfo(
            "Account Created",
            "Account successfully created!\n\nYour username is:\n" + username
        )

        self.show_login()
        self.username_entry.insert(0, username)
        self.password_entry.focus()

    # =====================================================
    # LOGIN CHECK
    # =====================================================

    def login(self):
        username = self.username_entry.get().strip()
        password = self.password_entry.get()

        if not username:
            messagebox.showinfo("PetLink", "Please enter your username.")
            return

        if not password:
            messagebox.showinfo("PetLink", "Please enter your password.")
            return

        if username not in self.accounts:
            messagebox.showerror("Login Failed", "Account not found.")
            return

        if self.accounts[username]["password"] != password:
            messagebox.showerror("Login Failed", "Incorrect password.")
            return

        self.current_user = username
        self.show_dashboard()

