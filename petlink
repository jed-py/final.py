        frame.pack(fill="both", expand=True, padx=40)

        my_pets = [
            pet for pet in self.pets
            if pet["posted_by"] == self.current_user
        ]

        if not my_pets:
            self.make_message("No records.")
            return

        for pet in my_pets:
            box = tk.Frame(frame, bg=self.WHITE, padx=10, pady=10)
            box.pack(fill="x", pady=6)

            tk.Label(
                box,
                text=pet["name"],
                font=("Arial", 16, "bold"),
                bg=self.WHITE,
                fg=self.TEXT_COLOR
            ).pack(pady=4)

            tk.Label(
                box,
                text=f"Breed: {pet['breed']} | Age: {pet['age']} | "
                     f"Status: {pet['status']}",
                font=("Arial", 11),
                bg=self.WHITE,
                fg=self.SUBTEXT_COLOR
            ).pack()

            if pet["status"] == "Available":
                tk.Button(
                    box,
                    text="Adopt",
                    bg=self.BUTTON_COLOR,
                    fg=self.WHITE,
                    bd=0,
                    cursor="hand2",
                    command=lambda p=pet: self.adopt_pet(p)
                ).pack(pady=6)
            else:
                tk.Label(
                    box,
                    text="Not Available",
                    bg=self.WHITE,
                    fg=self.RED
                ).pack(pady=6)

    # =====================================================
    # ADOPTION
    # =====================================================

    def adopt_pet(self, pet):
        if pet["status"] != "Available":
            messagebox.showinfo("PetLink", "This pet is not available.")
            return

        for application in self.applications:
            if (
                application["username"] == self.current_user
                and application["pet_record"] is pet
                and application["status"] == "Pending"
            ):
                messagebox.showinfo(
                    "PetLink",
                    "You already have a pending application for this pet."
                )
                return

        answer = messagebox.askyesno(
            "Adoption Application",
            f"Do you want to apply to adopt {pet['name']}?"
        )

        if not answer:
            return

        self.applications.append({
            "username": self.current_user,
            "pet": pet["name"],
            "breed": pet["breed"],
            "age": pet["age"],
            "status": "Pending",
            "pet_record": pet
        })

        messagebox.showinfo(
            "Application Submitted",
            "Your adoption application has been submitted.\n"
            "Please wait for the admin to review it."
        )

        self.show_application_form()

