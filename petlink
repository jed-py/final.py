    # ADMIN
    # =====================================================

    def open_admin(self):
        admin_passkey = "PETLINKADMIN2026"

        entered_key = simpledialog.askstring(
            "Admin Access",
            "Enter the admin passkey:",
            show="*",
            parent=self.root
        )

