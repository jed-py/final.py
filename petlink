    def update_posting_fields(self):
        for widget in self.post_fields_frame.winfo_children():
            widget.destroy()

        self.post_fields_frame.grid_columnconfigure(1, weight=1)

        label_style = {
            "font": ("Arial", 10, "bold"),
            "bg": self.WHITE,
            "fg": self.TEXT_COLOR,
            "anchor": "w"
        }

        entry_style = {
            "font": ("Arial", 10),
            "relief": "solid",
            "bd": 1
        }

        def add_entry(label, row, attribute):
            tk.Label(
                self.post_fields_frame,
                text=label,
                **label_style
            ).grid(
                row=row, column=0, sticky="w",
                padx=(0, 12), pady=6
            )

            entry = tk.Entry(self.post_fields_frame, **entry_style)
            entry.grid(
                row=row, column=1, sticky="ew",
                pady=6, ipady=4
            )

            setattr(self, attribute, entry)

        if self.post_kind_var.get() == "Pet for Adoption":
            add_entry("Pet Name", 0, "pet_name_entry")
            add_entry("Age", 1, "pet_age_entry")
            add_entry("Breed", 2, "pet_breed_entry")

        else:
            # STRAY REPORT: DOG OR CAT
            tk.Label(
                self.post_fields_frame,
                text="Animal Type",
                **label_style
            ).grid(
                row=0, column=0, sticky="w",
                padx=(0, 12), pady=6
            )

            self.stray_animal_type = tk.StringVar(value="Dog")

            tk.OptionMenu(
                self.post_fields_frame,
                self.stray_animal_type,
                "Dog",
                "Cat"
            ).grid(
                row=0, column=1, sticky="ew", pady=6
            )

            add_entry("Breed", 1, "pet_breed_entry")
            add_entry("Location / Barangay", 2, "pet_location_entry")

            tk.Label(
                self.post_fields_frame,
                text="Additional Information",
                **label_style
            ).grid(
                row=3, column=0, sticky="nw",
                padx=(0, 12), pady=6
            )

            self.pet_info_text = tk.Text(
                self.post_fields_frame,
                font=("Arial", 10),
                height=3,
                wrap="word",
                relief="solid",
                bd=1
            )
            self.pet_info_text.grid(
                row=3, column=1, sticky="ew", pady=6
            )

            tk.Label(
                self.post_fields_frame,
                text="Location must be within Pangasinan.",
                font=("Arial", 9, "italic"),
                bg=self.WHITE,
                fg=self.SUBTEXT_COLOR
            ).grid(
                row=4, column=0, columnspan=2,
                sticky="w", pady=(3, 0)
            )

    # =====================================================
    # SUBMIT POST
    # =====================================================

    def post_pet(self):
        category = self.post_kind_var.get()

        if category == "Pet for Adoption":
            name = self.pet_name_entry.get().strip()
            age = self.pet_age_entry.get().strip()
            breed = self.pet_breed_entry.get().strip()

            if not name or not age or not breed:
                messagebox.showwarning(
                    "Incomplete Information",
                    "Please enter the pet's name, age, and breed."
                )
                return

            self.pets.append({
                "name": name,
                "age": age,
                "breed": breed,
                "type": "Unknown",
                "location": "Not provided",
                "info": "No additional information provided.",
                "status": "Available",
                "posted_by": self.current_user,
                "adopted_by": None
            })

            message = "The pet has been posted successfully"

        else:
            animal_type = self.stray_animal_type.get()
            breed = self.pet_breed_entry.get().strip()
            location = self.pet_location_entry.get().strip()
            info = self.pet_info_text.get("1.0", tk.END).strip()

            if not breed or not location or not info:
                messagebox.showwarning(
                    "Incomplete Information",
                    "Please enter the breed, location, and additional information."
                )
                return

            # Save the selected dog or cat type
            self.stray_reports.append({
                "name": animal_type,
                "age": "Unknown",
                "breed": breed,
                "type": animal_type,
                "location": location,
                "province": "Pangasinan",
                "info": info,
                "status": "Reported",
                "reported_by": self.current_user
            })

            message = (
                f"The stray {animal_type.lower()} report "
                "has been submitted successfully."
            )

        messagebox.showinfo("Submission Successful", message)
        self.show_pet_posting()

    # =====================================================
    # DISPLAY MY SUBMISSIONS
    # =====================================================

    def display_my_posts(self):
        for widget in self.posted_frame.winfo_children():
            widget.destroy()

        my_pets = [
            pet for pet in self.pets
            if pet["posted_by"] == self.current_user
        ]

        my_reports = [
            report for report in self.stray_reports
            if report["reported_by"] == self.current_user
        ]

        if not my_pets and not my_reports:
            tk.Label(
                self.posted_frame,
                text="No submissions yet.",
                font=("Arial", 10),
                bg=self.BG_COLOR,
                fg=self.SUBTEXT_COLOR
            ).pack(pady=12)
            return

        def add_card(title, category, breed, age, location, status, info):
            card = tk.Frame(
                self.posted_frame,
                bg=self.WHITE,
                padx=12,
                pady=8,
                highlightbackground="#D3E1E1",
                highlightthickness=1
            )
            card.pack(fill="x", pady=4)

            tk.Label(
                card,
                text=title,
                font=("Arial", 11, "bold"),
                bg=self.WHITE,
                fg=self.NAV_COLOR,
                anchor="w"
            ).pack(fill="x", pady=(0, 3))

            tk.Label(
                card,
                text=f"Category: {category} | Breed: {breed} | Age: {age}",
                font=("Arial", 9),
                bg=self.WHITE,
                fg=self.TEXT_COLOR,
                anchor="w",
                wraplength=850,
                justify="left"
            ).pack(fill="x")

            tk.Label(
                card,
                text=f"Location: {location} | Status: {status}",
                font=("Arial", 9, "bold"),
                bg=self.WHITE,
                fg=self.TEXT_COLOR,
                anchor="w",
                wraplength=850,
                justify="left"
            ).pack(fill="x", pady=(3, 0))

            tk.Label(
                card,
                text=f"Additional Information: {info}",
                font=("Arial", 9),
                bg=self.WHITE,
                fg=self.SUBTEXT_COLOR,
                anchor="w",
                wraplength=850,
                justify="left"
            ).pack(fill="x", pady=(3, 0))

        for pet in my_pets:
            add_card(
                pet["name"],
                "Pet for Adoption",
                pet["breed"],
                pet["age"],
                pet.get("location", "Not provided"),
                pet["status"],
                pet.get("info", "None")
            )

        for report in my_reports:
            add_card(
                report["name"],
                "Stray Status Report",
                report["breed"],
                report["age"],
