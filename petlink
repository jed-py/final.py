    def show_admin(self):
        self.clear_content()
        self.make_title("Admin - Adoption Applications")

        tk.Label(
            self.content_frame,
            text="Review applications and approve or reject each request.",
            font=("Arial", 11),
            bg=self.BG_COLOR,
            fg=self.SUBTEXT_COLOR
        ).pack(pady=(0, 10))

        canvas = tk.Canvas(
            self.content_frame,
            bg=self.BG_COLOR,
            highlightthickness=0
        )
        scrollbar = tk.Scrollbar(
            self.content_frame,
            orient="vertical",
            command=canvas.yview
        )
        list_frame = tk.Frame(canvas, bg=self.BG_COLOR)

        list_frame.bind(
            "<Configure>",
            lambda event: canvas.configure(
                scrollregion=canvas.bbox("all")
            )
        )

        window_id = canvas.create_window(
            (0, 0),
            window=list_frame,
            anchor="nw"
        )

        canvas.configure(yscrollcommand=scrollbar.set)
        canvas.bind(
            "<Configure>",
            lambda event: canvas.itemconfigure(
                window_id, width=event.width
            )
        )

        canvas.pack(side="left", fill="both", expand=True, padx=(30, 0))
        scrollbar.pack(side="right", fill="y", padx=(0, 25))

        if not self.applications:
            tk.Label(
                list_frame,
                text="No adoption applications yet.",
                font=("Arial", 13),
                bg=self.BG_COLOR,
                fg=self.SUBTEXT_COLOR
            ).pack(pady=30)
            return

        for application in self.applications:
            box = tk.Frame(list_frame, bg=self.WHITE, padx=15, pady=10)
            box.pack(fill="x", pady=6, padx=5)

            tk.Label(
                box,
                text=application["pet"],
                font=("Arial", 15, "bold"),
                bg=self.WHITE,
                fg=self.TEXT_COLOR
            ).pack(pady=4)

            tk.Label(
                box,
                text=f"Applicant: {application['username']} | "
                     f"Breed: {application['breed']} | Age: {application['age']}",
                font=("Arial", 10),
                bg=self.WHITE,
                fg=self.SUBTEXT_COLOR
            ).pack(pady=2)

            status = application["status"]
            color = (
                self.GREEN if status == "Approved"
                else self.RED if status == "Rejected"
                else self.YELLOW
            )

            tk.Label(
                box,
                text="Status: " + status,
                font=("Arial", 11, "bold"),
                bg=self.WHITE,
                fg=color
            ).pack(pady=5)

            if status == "Pending":
                actions = tk.Frame(box, bg=self.WHITE)
                actions.pack(pady=4)

                tk.Button(
                    actions,
                    text="Approve",
                    bg=self.GREEN,
                    fg=self.WHITE,
                    bd=0,
                    padx=16,
                    pady=5,
                    cursor="hand2",
                    command=lambda a=application:
                    self.review_application(a, "Approved")
                ).pack(side="left", padx=6)

                tk.Button(
                    actions,
                    text="Reject",
                    bg=self.RED,
                    fg=self.WHITE,
                    bd=0,
                    padx=16,
                    pady=5,
                    cursor="hand2",
                    command=lambda a=application:
                    self.review_application(a, "Rejected")
                ).pack(side="left", padx=6)

    def review_application(self, application, decision):
        if application["status"] != "Pending":
            messagebox.showinfo(
                "PetLink",
                "This application has already been reviewed."
            )
            return

        pet = application.get("pet_record")

        if decision == "Approved":
            if pet is not None:
                if pet["status"] != "Available":
                    messagebox.showwarning(
                        "PetLink",
                        "This pet is no longer available. The application "
                        "cannot be approved."
                    )
                    application["status"] = "Rejected"
                    self.show_admin()
                    return

                pet["status"] = "Not Available"
                pet["adopted_by"] = application["username"]

            application["status"] = "Approved"

            applicant = application["username"]
            if applicant in self.accounts:
                self.accounts[applicant]["adopted"].append({
                    "name": application["pet"],
                    "breed": application["breed"],
                    "age": application["age"],
                    "status": "Not Available"
                })

            message = "The adoption application has been approved."

        else:
            application["status"] = "Rejected"
            message = "The adoption application has been rejected."

        messagebox.showinfo("Application Updated", message)
        self.show_admin()

